# ---------------------------------------------------------------------------
# MailOps backend environment
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000

# --- Datastores -------------------------------------------------------------
DATABASE_URL=postgresql://mailops:mailops@localhost:5433/mailops?schema=public
REDIS_URL=redis://localhost:6379

# --- Auth -------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-48-bytes-of-random-data
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
COOKIE_DOMAIN=
COOKIE_SECURE=false

# --- Encryption -------------------------------------------------------------
# 32-byte key, base64. Used for AES-256-GCM envelope encryption of OAuth tokens
# and integration secrets. Rotating this key requires re-encrypting stored rows.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=replace-me-with-base64-encoded-32-bytes

# --- Google / Gmail OAuth ---------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/gmail/oauth/callback
# Minimal scopes are hard-coded in src/services/gmail/scopes.ts and cannot be
# widened by configuration.
GMAIL_SYNC_LOOKBACK_DAYS=120
GMAIL_MAX_MESSAGES_PER_SCAN=200

# --- AI provider ------------------------------------------------------------
# heuristic | openai-compatible
AI_PROVIDER=heuristic
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_MS=25000
AI_MIN_CONFIDENCE=0.7
AI_REVIEW_THRESHOLD=0.55

# --- Slack ------------------------------------------------------------------
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=

# --- WhatsApp (compliant Business / Cloud API provider) ---------------------
WHATSAPP_PROVIDER=cloud-api
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_DEFAULT_TO=

# --- Voice (optional, V3; users must opt in) --------------------------------
VOICE_PROVIDER=twilio
VOICE_ACCOUNT_SID=
VOICE_AUTH_TOKEN=
VOICE_FROM_NUMBER=

# --- Email channel (optional) -----------------------------------------------
EMAIL_CHANNEL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=MailOps <no-reply@mailops.local>

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10

# --- Workers ----------------------------------------------------------------
WORKER_CONCURRENCY=4
SCHEDULER_ENABLED=true
LOG_LEVEL=info
